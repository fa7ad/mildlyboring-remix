{
  "private": true,
  "sideEffects": false,
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./server.js",
    "build": "run-s clean build:\\*",
    "build:css": "run-p buildcss:\\*",
    "build:remix": "remix build",
    "clean": "rimraf app/styles/\\*",
    "predev": "run-s clean buildcss:\\*",
    "dev": "run-p dev:\\*",
    "dev:node": "cross-env NODE_ENV=development nodemon ./server.js --watch ./server.js",
    "dev:remix": "remix watch",
    "dev:css": "run-p devcss:\\*",
    "devcss:tail": "tailwindcss -o ./app/styles/tailwind.global.css --watch",
    "devcss:post": "postcss styles --base styles --dir app/styles -w",
    "buildcss:tail": "tailwindcss -o ./app/styles/tailwind.global.css --minify",
    "buildcss:post": "postcss styles --base styles --dir app/styles --env production",
    "update-deps": "./.bin/update_deps.js"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@remix-run/express": "^2.17.4",
    "@remix-run/node": "^2.17.4",
    "@remix-run/react": "^2.17.4",
    "@remix-run/server-runtime": "^2.17.4",
    "@types/ramda": "^0.31.1",
    "@types/react-lazy-load-image-component": "^1.6.5",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.20",
    "disqus-react": "^1.1.7",
    "express": "^4.22.1",
    "glob": "^8.1.0",
    "got": "^12.6.1",
    "helmet": "^5.1.1",
    "html-react-parser": "^2.0.0",
    "morgan": "^1.10.1",
    "plaiceholder": "^2.5.0",
    "prismjs": "^1.30.0",
    "prop-types": "^15.8.1",
    "ramda": "^0.32.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-lazy-load-image-component": "^1.6.3",
    "react-redux": "^8.1.3",
    "rehype-katex": "^6.0.3",
    "rehype-prism-plus": "^1.6.3",
    "rehype-raw": "^6.1.1",
    "rehype-sanitize": "^5.0.1",
    "rehype-stringify": "^9.0.4",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "remark-parse": "^10.0.2",
    "remark-rehype": "^10.1.0",
    "remark-stringify": "^10.0.3",
    "remix-seo": "^0.1.0",
    "remix-utils": "^9.3.1",
    "sharp": "^0.34.5",
    "strip-markdown": "^5.0.1",
    "unified": "^10.1.2"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.4",
    "@remix-run/eslint-config": "^2.17.4",
    "@remix-run/serve": "^2.17.4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/prismjs": "^1.26.6",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "nodemon": "^2.0.22",
    "npm-remote-ls": "^1.3.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.9",
    "postcss-cli": "^9.1.0",
