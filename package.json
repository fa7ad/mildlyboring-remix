    "prettier": "^2.8.8",
    "rimraf": "^3.0.2",
    "stylelint": "^14.16.1",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard": "^26.0.0",
    "stylelint-config-tailwindcss": "^0.0.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=14"
  },
  "packageManager": "yarn@4.13.0"
}
