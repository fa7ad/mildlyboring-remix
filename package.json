{
  "private": true,
  "sideEffects": false,
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./server.js",
    "build": "run-s clean build:\\*",
    "build:css": "run-p buildcss:\\*",
    "build:remix": "remix build",
    "clean": "rimraf app/styles/\\*",
    "predev": "run-s clean buildcss:\\*",
    "dev": "run-p dev:\\*",
    "dev:node": "cross-env NODE_ENV=development nodemon ./server.js --watch ./server.js",
    "dev:remix": "remix watch",
    "dev:css": "run-p devcss:\\*",
    "devcss:tail": "tailwindcss -i ./styles/tailwind.css -o ./app/styles/tailwind.global.css --watch",
    "devcss:post": "postcss styles --base styles --dir app/styles -w",
    "buildcss:tail": "tailwindcss -i ./styles/tailwind.css -o ./app/styles/tailwind.global.css --minify",
    "buildcss:post": "postcss styles --base styles --dir app/styles --env production",
    "update-deps": "./.bin/update_deps.js"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@remix-run/express": "^2.17.4",
    "@remix-run/node": "^2.17.4",
    "@remix-run/react": "^2.17.4",
    "@remix-run/server-runtime": "^2.17.4",
    "@types/ramda": "^0.31.1",
    "@types/react-lazy-load-image-component": "^1.6.5",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.20",
    "disqus-react": "^1.1.7",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "got": "^15.0.1",
    "helmet": "^8.1.0",
    "html-react-parser": "^6.0.1",
    "morgan": "^1.10.1",
    "plaiceholder": "^3.0.0",
    "prismjs": "^1.30.0",
    "prop-types": "^15.8.1",
    "ramda": "^0.32.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-lazy-load-image-component": "^1.6.3",
    "react-redux": "^9.2.0",
    "rehype-katex": "^7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "remix-seo": "^0.1.0",
    "remix-utils": "^9.3.1",
    "sharp": "^0.34.5",
    "strip-markdown": "^6.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@remix-run/dev": "^2.17.4",
    "@remix-run/eslint-config": "^2.17.4",
    "@remix-run/serve": "^2.17.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.5.2",
    "@types/prismjs": "^1.26.6",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "nodemon": "^3.1.14",
    "npm-remote-ls": "^1.3.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.9",
    "postcss-cli": "^11.0.1",
    "postcss-modules": "^6.0.1",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=14"
  },
  "packageManager": "yarn@4.13.0"
}
